<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <Sts2AppPath Condition=" '$(Sts2AppPath)' == '' ">$(HOME)/Library/Application Support/Steam/steamapps/common/Slay the Spire 2/SlayTheSpire2.app</Sts2AppPath>
    <Sts2DataPath Condition=" '$(Sts2DataPath)' == '' ">$(Sts2AppPath)/Contents/Resources/data_sts2_macos_arm64</Sts2DataPath>
    <QuickMatchAndroidDll>$(MSBuildProjectDirectory)/../QuickMatch.Android/bin/$(Configuration)/net9.0/QuickMatchAndroid.dll</QuickMatchAndroidDll>
  </PropertyGroup>

  <ItemGroup>
    <!-- The launcher bridge and the lobby code are plain C# on SteamKit2, so the test compiles them directly (no game, no Godot). -->
    <Compile Include="../QuickMatch/Lobby/ILobbyBackend.cs" Link="Mod/ILobbyBackend.cs" />
    <Compile Include="../QuickMatch.Android/Launcher/*.cs" Link="Mod/Launcher/%(Filename)%(Extension)" />
    <Compile Include="../QuickMatch.Android/Lobby/*.cs" Link="Mod/Lobby/%(Filename)%(Extension)" />
    <Compile Include="../QuickMatch.Android/Logging/IModLog.cs" Link="Mod/Logging/IModLog.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Patch-target test inspects the built mod and the installed game without loading them. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Sts2DataPath</_Parameter1>
      <_Parameter2>$(Sts2DataPath)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>QuickMatchAndroidDll</_Parameter1>
      <_Parameter2>$(QuickMatchAndroidDll)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.7" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="SteamKit2" Version="3.4.0" />
  </ItemGroup>
</Project>
